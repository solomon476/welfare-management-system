# Solian Wolves Welfare Management System - Environment Variables
# Copy this file to .env and configure with your production credentials

ENVIRONMENT=production
PROJECT_NAME="Solian Wolves Welfare Management System API"

# PostgreSQL Database Connection
# Option A: Supabase Managed PostgreSQL
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Option B: Render Managed PostgreSQL
# DATABASE_URL=postgresql://solian_user:[PASSWORD]@dpg-[ID]-a.oregon-postgres.render.com/solian_db
# Local SQLite fallback for testing:
DATABASE_URL=sqlite:///./welfare_system.db

# Database Connection Pool (Bounded for 100-1,000 members)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Financial Settings
CURRENCY=KES
DEFAULT_OPENING_RESERVE=200000.00
APPROVAL_QUORUM=2

# Security & Authentication (Replace in production)
SECRET_KEY=generate-a-strong-random-64-character-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Port
PORT=8000
